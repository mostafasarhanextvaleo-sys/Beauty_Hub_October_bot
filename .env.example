PORT=3000
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
AI_PROVIDER=none
# OPENAI_API_KEY is used both by the legacy rule engine's rephrase-only step
# (AI_PROVIDER=openai) AND by the LLM agent (src/bot/llmAgent.js), which tries
# it as the primary tier when LOCAL_AGENT_ENABLED=false (2026-07-18: this is
# the live setting for the 2-month OpenAI data-gathering trial), or as the
# first backup tier after the local model otherwise. Keep it set once
# AGENT_MODE=llm is live.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SESSION_PATH=./.wwebjs_auth
CART_NUDGE_DELAY_HOURS=3
ADMIN_WHATSAPP_NUMBER=

# --- LLM-driven agent (src/bot/llmAgent.js) ---
# 'rules' = existing state-machine engine (default). 'llm' = free-form agent,
# tier order local -> openai -> gemini (see the local-tier block below).
AGENT_MODE=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Gemini is the LAST tier (after local and openai both fail). 'false' skips it
# and goes straight to the static canned reply.
GEMINI_FALLBACK_ENABLED=true
# Comma-separated WhatsApp numbers to canary the LLM agent on, even while
# AGENT_MODE=rules for everyone else. E.g. LLM_AGENT_TEST_CHAT_IDS=201098175119
LLM_AGENT_TEST_CHAT_IDS=

# --- Local-first tier (src/services/localService.js) ---
# Tier order is local -> openai -> gemini. Requires a running Ollama server
# with the listed models pulled (ollama pull <model>).
OLLAMA_URL=http://localhost:11434
LOCAL_MODELS=gemma2:2b-instruct-q4_K_M,qwen2.5:1.5b
LOCAL_TIMEOUT_MS=20000
# Master kill switch — 'false' skips straight to openai/gemini for everyone.
# Set to 'false' 2026-07-18 for the 2-month OpenAI data-gathering trial —
# flip back to 'true' for an instant rollback to the local tier if needed.
LOCAL_AGENT_ENABLED=true
# Comma-separated WhatsApp numbers that try the local model first. Empty by
# default — the local tier is only attempted for numbers listed here, so it
# can be validated on a few real numbers before wider rollout.
LOCAL_AGENT_TEST_CHAT_IDS=

# --- Semantic product search (src/bot/productSearch.js), 2026-07-18 ---
# Embedding-based matching (OpenAI text-embedding-3-small) is the primary
# path for product recommendations, with the original keyword matcher as an
# automatic fallback. 'false' is an instant rollback to keyword-only matching.
SEMANTIC_SEARCH_ENABLED=true

# --- Invoice generation (src/index.js GET /invoice/:rowNumber), 2026-07-30 ---
# Rendered on-the-fly and printed straight from the browser (Ctrl+P) — no
# Drive, no OAuth, nothing stored. Must be an address this server is actually
# reachable at from wherever the "Print Invoice" link gets clicked (a phone,
# a laptop) — NOT localhost, which only resolves on this machine itself.
PUBLIC_BASE_URL=
# Leave blank — auto-generated once on first run and appended to .env (see
# src/config.js). Required as a ?token= query param on /invoice/:rowNumber so
# the endpoint can't be scanned for every customer's name/phone/address.
INVOICE_VIEW_TOKEN=
