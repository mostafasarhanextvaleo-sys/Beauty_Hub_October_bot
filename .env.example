PORT=3000
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
AI_PROVIDER=none
# OPENAI_API_KEY is used both by the legacy rule engine's rephrase-only step
# (AI_PROVIDER=openai) AND as the automatic fallback provider for the LLM agent
# below when Gemini is unavailable. Keep it set once AGENT_MODE=llm is live.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SESSION_PATH=./.wwebjs_auth
CART_NUDGE_DELAY_HOURS=3
ADMIN_WHATSAPP_NUMBER=

# --- LLM-driven agent (src/bot/llmAgent.js) ---
# 'rules' = existing state-machine engine (default). 'llm' = free-form Gemini agent.
AGENT_MODE=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Automatically falls back to OpenAI gpt-4o-mini (structured output) if Gemini fails.
GEMINI_FALLBACK_ENABLED=true
# Comma-separated WhatsApp numbers to canary the LLM agent on, even while
# AGENT_MODE=rules for everyone else. E.g. LLM_AGENT_TEST_CHAT_IDS=201098175119
LLM_AGENT_TEST_CHAT_IDS=
